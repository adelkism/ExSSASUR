{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exssasur-private",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "secrets": {
    "required": ["ACCESS_TOKEN"]
  }
}
